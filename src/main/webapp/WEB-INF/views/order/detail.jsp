<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Chi tiết đơn hàng" scope="request" />
<jsp:include page="../components/header.jsp" />
<div class="section-head"><div><p class="eyebrow">Đơn hàng</p><h1><c:out value="${order.orderCode}" /></h1></div><span class="badge ${order.status == 'COMPLETED' ? 'badge-success' : order.status == 'CANCELLED' ? 'badge-danger' : 'badge-warning'}"><c:out value="${order.status}" /></span></div>
<div class="split-grid">
    <section class="panel"><h2>Sản phẩm</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr></thead><tbody><c:forEach var="item" items="${orderItems}"><tr><td><strong><c:out value="${item.productName}" /></strong><br><span class="muted"><c:out value="${item.variantName}" /> · <c:out value="${item.sku}" /></span></td><td><fmt:formatNumber value="${item.unitPrice}" pattern="#,##0" /> ₫</td><td>${item.quantity}</td><td class="money"><fmt:formatNumber value="${item.lineTotal}" pattern="#,##0" /> ₫</td></tr></c:forEach></tbody></table></div><div class="summary-line summary-total"><strong>Tổng thanh toán</strong><strong class="price"><fmt:formatNumber value="${order.totalAmount}" pattern="#,##0" /> ₫</strong></div></section>
    <div><section class="panel"><h2>Giao hàng</h2><p><strong><c:out value="${order.receiverName}" /></strong><br><c:out value="${order.receiverPhone}" /><br><c:out value="${order.shippingAddress}" /></p><c:if test="${not empty order.customerNote}"><p class="muted">Ghi chú: <c:out value="${order.customerNote}" /></p></c:if><c:if test="${(order.status == 'PENDING' || order.status == 'CONFIRMED' || order.status == 'PROCESSING') && sessionScope.user.role != 'ADMIN'}"><form action="${ctx}/orders/cancel" method="post"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="orderId" value="${order.orderId}"><button class="btn btn-danger" type="submit" data-confirm="Ông chắc chắn muốn hủy đơn này?">Hủy đơn hàng</button></form></c:if></section><section class="panel subsection"><h2>Lịch sử trạng thái</h2><ol class="timeline"><c:forEach var="history" items="${histories}"><li><strong><c:out value="${history.status}" /></strong><br><span class="muted"><c:out value="${history.createdAt}" /></span><c:if test="${not empty history.note}"><br><c:out value="${history.note}" /></c:if></li></c:forEach></ol></section></div>
</div>
<jsp:include page="../components/footer.jsp" />
