<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Quản lý đơn hàng" scope="request" />
<jsp:include page="../components/header.jsp" />
<jsp:include page="../components/admin-nav.jsp" />
<div class="section-head"><div><p class="eyebrow">Vận hành</p><h1>Quản lý đơn hàng</h1></div><form method="get" action="${ctx}/admin/orders"><select name="status" onchange="this.form.submit()"><option value="">Tất cả trạng thái</option><c:forEach var="state" items="${['PENDING','CONFIRMED','PROCESSING','SHIPPING','COMPLETED','CANCELLED']}"><option value="${state}" ${selectedStatus == state ? 'selected' : ''}>${state}</option></c:forEach></select></form></div>
<section class="panel table-wrap"><table class="data-table"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Tổng tiền</th><th>Hiện tại</th><th>Chuyển trạng thái</th><th></th></tr></thead><tbody><c:forEach var="order" items="${orders}"><tr><td><strong><c:out value="${order.orderCode}" /></strong></td><td><c:out value="${order.user.fullName}" /></td><td class="money"><fmt:formatNumber value="${order.totalAmount}" pattern="#,##0" /> ₫</td><td><span class="badge ${order.status == 'COMPLETED' ? 'badge-success' : order.status == 'CANCELLED' ? 'badge-danger' : 'badge-warning'}"><c:out value="${order.status}" /></span></td><td><c:if test="${order.status != 'COMPLETED' && order.status != 'CANCELLED'}"><form action="${ctx}/admin/orders/status" method="post" class="inline-form"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="orderId" value="${order.orderId}"><select name="status"><option value="CONFIRMED">CONFIRMED</option><option value="PROCESSING">PROCESSING</option><option value="SHIPPING">SHIPPING</option><option value="COMPLETED">COMPLETED</option><option value="CANCELLED">CANCELLED</option></select><button class="btn btn-primary btn-small" type="submit">Cập nhật</button></form></c:if></td><td><a class="btn btn-secondary btn-small" href="${ctx}/orders/detail?code=${order.orderCode}">Chi tiết</a></td></tr></c:forEach></tbody></table></section>
<jsp:include page="../components/footer.jsp" />
