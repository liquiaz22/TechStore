<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="pageTitle" value="${empty product.productId ? 'Thêm sản phẩm' : 'Chỉnh sửa sản phẩm'}" scope="request" />
<jsp:include page="../components/admin-header.jsp" />
<c:url var="backToProductsUrl" value="/admin/products"><c:param name="q" value="${param.q}"/><c:param name="status" value="${param.listStatus}"/><c:param name="page" value="${param.page}"/></c:url>
<div class="section-head"><div><p class="eyebrow">Sản phẩm</p><h1>${empty product.productId ? 'Thêm sản phẩm' : 'Chỉnh sửa sản phẩm'}</h1></div><a class="btn btn-ghost" href="${backToProductsUrl}">Quay lại</a></div>

<section class="panel">
    <form action="${ctx}/admin/products/save" method="post" class="form-grid">
        <input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="id" value="${product.productId}">
        <input type="hidden" name="q" value="<c:out value='${param.q}'/>"><input type="hidden" name="listStatus" value="<c:out value='${param.listStatus}'/>"><input type="hidden" name="page" value="<c:out value='${param.page}'/>">
        <div class="field"><label>Tên sản phẩm</label><input name="name" maxlength="250" value="<c:out value='${product.name}'/>" required></div>
        <div class="field"><label>Slug</label><input name="slug" maxlength="300" pattern="[a-z0-9-]+" value="<c:out value='${product.slug}'/>" required></div>
        <div class="field"><label>Danh mục</label><select name="categoryId" required><option value="">Chọn danh mục</option><c:forEach var="category" items="${categories}"><option value="${category.categoryId}" ${not empty product.category && product.category.categoryId == category.categoryId ? 'selected' : ''}><c:out value="${category.name}" /></option></c:forEach></select></div>
        <div class="field"><label>Thương hiệu</label><select name="brandId"><option value="">Không có</option><c:forEach var="brand" items="${brands}"><option value="${brand.brandId}" ${not empty product.brand && product.brand.brandId == brand.brandId ? 'selected' : ''}><c:out value="${brand.name}" /></option></c:forEach></select></div>
        <div class="field"><label>Trạng thái</label><select name="status"><option value="DRAFT" ${product.status == 'DRAFT' ? 'selected' : ''}>DRAFT</option><option value="ACTIVE" ${product.status == 'ACTIVE' ? 'selected' : ''}>ACTIVE</option><option value="INACTIVE" ${product.status == 'INACTIVE' ? 'selected' : ''}>INACTIVE</option></select></div>
        <div class="field full"><label>Mô tả ngắn</label><textarea name="shortDescription" maxlength="1000"><c:out value="${product.shortDescription}" /></textarea></div>
        <div class="field full"><label>Mô tả đầy đủ</label><textarea name="description" maxlength="20000"><c:out value="${product.description}" /></textarea></div>
        <button class="btn btn-primary full" type="submit">Lưu sản phẩm</button>
    </form>
</section>

<c:if test="${not empty product.productId}">
    <section class="panel subsection">
        <h2>Phiên bản sản phẩm</h2>
        <form action="${ctx}/admin/products/variant/save" method="post" class="form-grid">
            <input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="productId" value="${product.productId}"><input type="hidden" name="id" value="${editingVariant.variantId}">
            <div class="field"><label>SKU</label><input name="sku" maxlength="100" value="<c:out value='${editingVariant.sku}'/>" required></div><div class="field"><label>Tên phiên bản</label><input name="variantName" maxlength="200" placeholder="256GB - Đen" value="<c:out value='${editingVariant.variantName}'/>" required></div>
            <div class="field"><label>Màu sắc</label><input name="color" maxlength="100" value="<c:out value='${editingVariant.color}'/>"></div><div class="field"><label>RAM</label><input name="ram" maxlength="50" value="<c:out value='${editingVariant.ram}'/>"></div><div class="field"><label>Dung lượng</label><input name="storage" maxlength="50" value="<c:out value='${editingVariant.storage}'/>"></div>
            <div class="field"><label>Giá bán</label><input name="price" type="number" min="0" step="1000" value="<c:out value='${editingVariant.price}'/>" required></div><div class="field"><label>Giá gốc</label><input name="originalPrice" type="number" min="0" step="1000" value="<c:out value='${editingVariant.originalPrice}'/>"></div><div class="field"><label>Tồn kho</label><input name="stockQuantity" type="number" min="0" value="${empty editingVariant.variantId ? 0 : editingVariant.stockQuantity}" required></div>
            <label class="check-row"><input type="checkbox" name="active" ${empty editingVariant.variantId || editingVariant.active ? 'checked' : ''}> Đang bán</label><div class="form-actions"><button class="btn btn-primary" type="submit">${empty editingVariant.variantId ? 'Thêm phiên bản' : 'Lưu phiên bản'}</button><c:if test="${not empty editingVariant.variantId}"><a class="btn btn-ghost" href="${ctx}/admin/products/form?id=${product.productId}">Hủy sửa</a></c:if></div>
        </form>
        <div class="table-wrap subsection"><table class="data-table admin-responsive-table"><thead><tr><th>SKU</th><th>Phiên bản</th><th>Giá</th><th>Tồn kho</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="variant" items="${variants}"><tr><td data-label="SKU"><c:out value="${variant.sku}" /></td><td data-label="Phiên bản"><c:out value="${variant.variantName}" /></td><td data-label="Giá" class="money"><fmt:formatNumber value="${variant.price}" pattern="#,##0" /> ₫</td><td data-label="Tồn kho"><span class="badge ${variant.stockQuantity == 0 ? 'badge-danger' : variant.stockQuantity <= 5 ? 'badge-warning' : 'badge-success'}">${variant.stockQuantity}</span></td><td data-label="Trạng thái"><span class="badge ${variant.active ? 'badge-success' : 'badge-neutral'}">${variant.active ? 'Đang bán' : 'Đang ẩn'}</span></td><td data-label="Thao tác"><a class="btn btn-secondary btn-small" href="${ctx}/admin/products/form?id=${product.productId}&amp;editVariant=${variant.variantId}">Sửa</a></td></tr></c:forEach><c:if test="${empty variants}"><tr><td colspan="6">Chưa có phiên bản.</td></tr></c:if></tbody></table></div>
    </section>

    <div class="split-grid subsection">
        <section class="panel">
            <h2>Hình ảnh</h2>
            <form action="${ctx}/admin/products/image/save" method="post" enctype="multipart/form-data" class="form-grid">
                <input type="hidden" name="_csrf" value="${sessionScope.csrfToken}">
                <input type="hidden" name="productId" value="${product.productId}">
                <div class="field full"><label>File ảnh JPEG/PNG</label><input name="imageFile" type="file" accept="image/jpeg,image/png"><small class="muted">Tối đa 5 MB, 6000 × 6000 và 25 triệu pixel. Tên file sẽ được hệ thống tạo lại.</small></div>
                <div class="field full"><label>Hoặc URL hình ảnh</label><input name="imageUrl" type="url" maxlength="500" placeholder="https://..."></div>
                <div class="field"><label>Phiên bản</label><select name="variantId"><option value="">Ảnh chung</option><c:forEach var="variant" items="${variants}"><option value="${variant.variantId}"><c:out value="${variant.variantName}" /></option></c:forEach></select></div>
                <div class="field"><label>Thứ tự</label><input name="sortOrder" type="number" value="0"></div>
                <label class="check-row"><input type="checkbox" name="primary"> Ảnh chính</label>
                <button class="btn btn-primary" type="submit">Thêm ảnh</button>
            </form>
            <div class="subsection image-admin-list"><c:forEach var="image" items="${images}"><c:url var="localImageUrl" value="/${image.imageUrl}" /><article class="image-admin-item"><img src="${fn:startsWith(image.imageUrl, 'http') ? image.imageUrl : localImageUrl}" alt="Ảnh quản trị của <c:out value='${product.name}'/>"><div class="image-admin-detail"><div class="muted image-path"><c:out value="${image.imageUrl}" /></div><form action="${ctx}/admin/products/image/update" method="post" class="image-meta-form"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="productId" value="${product.productId}"><input type="hidden" name="id" value="${image.imageId}"><div class="field"><label>Thứ tự</label><input name="sortOrder" type="number" min="0" value="${image.sortOrder}" required></div><label class="check-row"><input type="checkbox" name="primary" ${image.primary ? 'checked' : ''}> Ảnh chính</label><button class="btn btn-secondary btn-small" type="submit">Lưu</button></form><form action="${ctx}/admin/products/image/delete" method="post" onsubmit="return confirm('Xóa hình ảnh này?')"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="productId" value="${product.productId}"><input type="hidden" name="id" value="${image.imageId}"><button class="btn btn-danger btn-small" type="submit">Xóa</button></form></div></article></c:forEach><c:if test="${empty images}"><p class="muted">Chưa có hình ảnh.</p></c:if></div>
        </section>
        <section class="panel"><h2>Thông số kỹ thuật</h2><form action="${ctx}/admin/products/spec/save" method="post" class="form-grid"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="productId" value="${product.productId}"><div class="field"><label>Tên thông số</label><input name="specificationName" maxlength="150" required></div><div class="field"><label>Giá trị</label><input name="specificationValue" maxlength="500" required></div><div class="field"><label>Thứ tự</label><input name="sortOrder" type="number" min="0" value="0"></div><button class="btn btn-primary" type="submit">Thêm thông số</button></form><div class="subsection spec-admin-list"><c:forEach var="spec" items="${specifications}"><article class="spec-admin-item"><form action="${ctx}/admin/products/spec/save" method="post" class="form-grid"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="productId" value="${product.productId}"><input type="hidden" name="id" value="${spec.specificationId}"><div class="field"><label>Tên</label><input name="specificationName" maxlength="150" value="<c:out value='${spec.specificationName}'/>" required></div><div class="field"><label>Giá trị</label><input name="specificationValue" maxlength="500" value="<c:out value='${spec.specificationValue}'/>" required></div><div class="field"><label>Thứ tự</label><input name="sortOrder" type="number" min="0" value="${spec.sortOrder}" required></div><button class="btn btn-secondary btn-small" type="submit">Lưu</button></form><form action="${ctx}/admin/products/spec/delete" method="post" onsubmit="return confirm('Xóa thông số này?')"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="productId" value="${product.productId}"><input type="hidden" name="id" value="${spec.specificationId}"><button class="btn btn-danger btn-small" type="submit">Xóa</button></form></article></c:forEach><c:if test="${empty specifications}"><p class="muted">Chưa có thông số.</p></c:if></div></section>
    </div>
</c:if>
<jsp:include page="../components/admin-footer.jsp" />
