<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:url var="productDetailUrl" value="/product"><c:param name="slug" value="${card.slug}" /></c:url>
<c:set var="isFavoriteCard" value="${favoriteProductIdMap[card.productId] == true}" />
<article class="product-card">
    <div class="product-card-media">
    <a class="product-card-image-link" href="${productDetailUrl}" aria-label="Xem chi tiết ${fn:escapeXml(card.name)}">
        <c:choose>
            <c:when test="${fn:startsWith(card.imageUrl, 'http')}"><img class="product-image" src="${card.imageUrl}" alt="<c:out value='${card.name}'/>"></c:when>
            <c:otherwise><img class="product-image" src="${ctx}/${card.imageUrl}" alt="<c:out value='${card.name}'/>"></c:otherwise>
        </c:choose>
    </a>
    <c:if test="${card.discountPercent > 0}"><span class="discount-badge">-${card.discountPercent}%</span></c:if>
    </div>
    <div class="product-body">
        <p class="product-brand"><c:out value="${empty card.brandName ? card.categoryName : card.brandName}" /></p>
        <h3 class="product-title"><a href="${productDetailUrl}"><c:out value="${card.name}" /></a></h3>
        <c:if test="${not empty card.quickSpecs}"><ul class="product-quick-specs" aria-label="Thông số nổi bật"><c:forEach var="spec" items="${card.quickSpecs}"><li><c:out value="${spec}" /></li></c:forEach></ul></c:if>
        <c:if test="${not empty card.variantOptions}"><p class="product-variants"><span>Tùy chọn:</span> <c:forEach var="option" items="${card.variantOptions}" varStatus="loop"><c:out value="${option}" />${loop.last ? '' : ' · '}</c:forEach></p></c:if>
        <div class="product-card-bottom">
        <div class="price-row"><span class="price"><fmt:formatNumber value="${card.price}" pattern="#,##0" /> ₫</span><c:if test="${card.discountPercent > 0}"><span class="old-price"><fmt:formatNumber value="${card.originalPrice}" pattern="#,##0" /> ₫</span></c:if></div>
        <p class="stock-row"><span class="badge ${card.inStock ? 'badge-success' : 'badge-danger'}">${card.inStock ? 'Còn hàng' : 'Hết hàng'}</span></p>
        <c:if test="${showFavoriteQuickAdd}">
            <c:set var="quickVariants" value="${favoriteVariants[card.productId]}" />
            <form class="favorite-quick-add" action="${ctx}/cart/add" method="post">
                <input type="hidden" name="_csrf" value="${sessionScope.csrfToken}">
                <input type="hidden" name="quantity" value="1">
                <label class="sr-only" for="favoriteVariant${card.productId}">Chọn phiên bản của <c:out value="${card.name}" /></label>
                <select id="favoriteVariant${card.productId}" name="variantId" required ${empty quickVariants ? 'disabled' : ''}>
                    <c:forEach var="quickVariant" items="${quickVariants}"><option value="${quickVariant.variantId}"><c:out value="${quickVariant.variantName}" /> — <fmt:formatNumber value="${quickVariant.price}" pattern="#,##0" /> ₫</option></c:forEach>
                    <c:if test="${empty quickVariants}"><option>Đang hết hàng</option></c:if>
                </select>
                <button class="btn btn-primary" type="submit" ${empty quickVariants ? 'disabled' : ''}>Thêm vào giỏ</button>
            </form>
        </c:if>
        <div class="card-actions">
            <a class="btn btn-secondary" href="${productDetailUrl}">Xem chi tiết</a>
            <c:choose>
                <c:when test="${not empty sessionScope.user}"><form action="${ctx}/favorites/toggle" method="post" class="inline-form"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="productId" value="${card.productId}"><input type="hidden" name="back" value="${favoriteBack}"><button class="btn btn-ghost favorite-button ${isFavoriteCard ? 'active' : ''}" type="submit" aria-label="${isFavoriteCard ? 'Bỏ' : 'Thêm'} ${fn:escapeXml(card.name)} ${isFavoriteCard ? 'khỏi' : 'vào'} yêu thích" title="${isFavoriteCard ? 'Bỏ yêu thích' : 'Thêm vào yêu thích'}">${isFavoriteCard ? '♥' : '♡'}</button></form></c:when>
                <c:otherwise><a class="btn btn-ghost favorite-button" href="${ctx}/login" aria-label="Đăng nhập để thêm ${fn:escapeXml(card.name)} vào yêu thích" title="Đăng nhập để yêu thích">♡</a></c:otherwise>
            </c:choose>
        </div>
        </div>
    </div>
</article>
